# Every provider is optional. The system runs with none of them configured and
# reports honestly which capabilities are active (GET /api/runtime).

# --- Language model (optional) -------------------------------------------
# Without a model, claims are selected verbatim from sources rather than
# written, verification is rule-based, and the knowledge graph is not written.
#
# NOT tied to OpenAI. Any server speaking the OpenAI chat-completions API works.
# The real requirement is reliable JSON-mode output.
#
#   Groq — hosted open-weights, free tier, no install (recommended)
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_API_KEY=gsk_...
#     LLM_MODEL=llama-3.3-70b-versatile      # claim extraction
#     LLM_FAST_MODEL=llama-3.1-8b-instant    # planning, verification, answers
#     LLM_MAX_CONCURRENCY=2                  # free tiers meter tokens per minute
#
#   OpenAI
#     OPENAI_API_KEY=sk-...
#     LLM_MODEL=gpt-4.1-mini
#
#   Ollama / vLLM / LM Studio (needs enough RAM for the model — roughly 16 GB
#   for a 14B model, which is the practical floor for claim extraction)
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=qwen2.5:14b
#
# OPENAI_API_KEY is only ever sent to OpenAI. When LLM_BASE_URL is set, only
# LLM_API_KEY is used.
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_FAST_MODEL=
LLM_MAX_CONCURRENCY=4
LLM_DOC_CHARS=6000

# --- Embeddings -----------------------------------------------------------
# fastembed: an open model run in-process on ONNX. No server, no key, no GPU.
# api: send embeddings to EMBEDDING_BASE_URL, or to OpenAI.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BASE_URL=
# Only sent to EMBEDDING_BASE_URL. The generation key is never used for a
# different embedding provider.
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=

# --- Vector store (optional) ---------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=cardio4cities_evidence

# --- Graph store (optional; also needs a language model) ------------------
# Use a Neo4j Graph Database Sandbox (https://sandbox.neo4j.com). Sandboxes
# expire after 3 days, extendable once to 10; a new one has a new bolt URI.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPHITI_ENABLED=false

# --- Web search (strongly recommended) -----------------------------------
# Tavily is the provider the deployment uses: government, municipal and
# programme pages the scholarly APIs never return. Free key (1,000 searches a
# month) at https://app.tavily.com. One search per planned query: 3 for a Quick
# run, up to 12 for Thorough. No spaces around the value.
# Without a web-search key the brief leans academic and the run records a gap.
TAVILY_API_KEY=
# Alternatives to Tavily.
BRAVE_API_KEY=
SERPER_API_KEY=

# --- Research budget ------------------------------------------------------
RESEARCH_MAX_ROUNDS=2
RESEARCH_QUERIES_PER_ROUND=5
RESEARCH_RESULTS_PER_QUERY=5
RESEARCH_MAX_FETCHES=10
RESEARCH_MAX_CLAIMS_PER_SOURCE=5
RESEARCH_SUFFICIENCY_DIMENSIONS=3
RESEARCH_HTTP_TIMEOUT=20
